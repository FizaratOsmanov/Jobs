@model ICollection<AdminGetJobDTO>


<div class="container mt-4">
	<h2 class="text-center text-primary mb-4">İşlər Cədvəli</h2>

	<p class="card-description">
		<a asp-action="Create" class="btn btn-success btn-sm">
			<i class="fas fa-plus"></i> Create
		</a>
	</p>

	<div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
		<table class="table table-hover table-striped shadow-sm rounded">
			<thead class="bg-dark text-white">
				<tr>
					<th class="text-center">#</th>
					<th class="text-center">Company Icon</th>
					<th class="text-center" style="max-width: 150px;">Title</th>
					<th class="text-center" style="max-width: 250px;">JobNature</th>
					<th class="text-center">CategoryTitle</th>
					<th class="text-center">IsDeleted</th>
					<th class="text-center">Actions</th>
				</tr>
			</thead>
			<tbody>
				@foreach (AdminGetJobDTO item in Model)
				{
					string disabled = item.IsDeleted ? "disabled-link" : string.Empty;
					<tr>
						<td class="align-middle text-center">@item.Id</td>
						<td class="align-middle text-center">
							<img style="object-fit: cover; width: 100px; height: 60px;" src="~/Uploads/Jobs/@item.CompanyIconPath" alt="Inner Image" />
						</td>
						<td class="align-middle text-break" style="word-wrap: break-word; white-space: normal; max-width: 150px;">@item.Title</td>
						<td class="align-middle text-break" style="word-wrap: break-word; white-space: normal; max-width: 250px;">@item.JobNature</td>
						<td class="align-middle text-break" style="word-wrap: break-word; white-space: normal; max-width: 250px;">@item.CategoryTitle</td>
						<td class="align-middle text-center">@item.IsDeleted</td>
						<td class="align-middle text-center" style="white-space: nowrap;">
							<a class="btn btn-info" asp-action="Details" asp-route-id="@item.Id">Details</a>
							<a class="btn btn-warning btn-sm d-inline-block mx-1 text-white" asp-action="Update" asp-route-id="@item.Id">Update</a>
							<a class="btn btn-danger btn-sm d-inline-block mx-1 @disabled" asp-action="SoftDelete" asp-route-id="@item.Id">SoftDelete</a>
							<a class="btn btn-danger btn-sm d-inline-block mx-1" asp-action="HardDelete" asp-route-id="@item.Id">HardDelete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>


	<style>
		.disabled-link {
			pointer-events: none;
			opacity: 0.5;
		}
	</style>
